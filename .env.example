[TEMPLATE]
# Токен бота от @BotFather (обязательно)
WEATHER_BOT_TOKEN=123456:ABC-DEF...

# 1 = демо-режим (выдуманная погода) | 0 = Open-Meteo API (бесплатный, без ключа)
WEATHER_DEMO_MODE=1

# Час ежедневной рассылки погоды (локальное время)
DAILY_DIGEST_HOUR=9

# --- Продвинутые настройки ---
# TTL кэша прогноза (секунды)
WEATHER_CACHE_TTL_SECONDS=1800
# Город по умолчанию
WEATHER_DEFAULT_CITY=Москва
# Минимальный интервал между сообщениями пользователя (секунды)
THROTTLE_MIN_INTERVAL=0.7
